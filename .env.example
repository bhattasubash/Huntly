# ─────────────────────────────────────────────
#  Huntly — Environment Configuration
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Supabase Project URL (from: Project Settings → API → Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key — NEVER expose this client-side
# (from: Project Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API Key (from: aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# Telegram Bot Token (from: @BotFather on Telegram → /newbot)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Telegram Chat ID where alerts are dispatched
# To find your Chat ID: message your bot, then visit:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your-chat-id-here
